{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "021_sports_prediction_statistical_visualization_v2",
  "benchmark_revision": "batch-07",
  "review_status": "author_review_pending",
  "title": "Convergent All-Star feature branches with diagnostic fan-out",
  "domain": "sports",
  "family_id": "allstar_multibranch_diagnostics",
  "topology": "fan_in_fan_out",
  "inputs": [
    {
      "id": "input:data.csv",
      "path": "inputs/data.csv",
      "format": "csv",
      "required_columns": [
        "player_id",
        "team",
        "position",
        "all_star",
        "games_played",
        "points_per_game",
        "assists_per_game",
        "rebounds_per_game",
        "minutes_per_game",
        "age",
        "experience_years",
        "salary_millions",
        "injury_games_missed",
        "contract_year",
        "field_goal_pct",
        "three_point_pct",
        "free_throw_pct"
      ]
    }
  ],
  "tasks": [
    {
      "id": "validate",
      "name": "Validate players",
      "operation": "source_validation",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "players_clean.csv"
      ],
      "requirements": [
        "Validate IDs, target, and finite fields."
      ],
      "parameters": {}
    },
    {
      "id": "performance",
      "name": "Derive performance features",
      "operation": "feature_engineering",
      "required": true,
      "inputs": [
        "players_clean.csv"
      ],
      "outputs": [
        "performance_features.csv"
      ],
      "requirements": [
        "Compute production index and retain performance fields."
      ],
      "parameters": {}
    },
    {
      "id": "shooting",
      "name": "Derive shooting features",
      "operation": "feature_engineering",
      "required": true,
      "inputs": [
        "players_clean.csv"
      ],
      "outputs": [
        "shooting_features.csv"
      ],
      "requirements": [
        "Compute shooting index and retain percentages."
      ],
      "parameters": {}
    },
    {
      "id": "integrate",
      "name": "Join model feature branches",
      "operation": "feature_join",
      "required": true,
      "inputs": [
        "players_clean.csv",
        "performance_features.csv",
        "shooting_features.csv"
      ],
      "outputs": [
        "model_data.csv"
      ],
      "requirements": [
        "Join one-to-one by player."
      ],
      "parameters": {}
    },
    {
      "id": "fit",
      "name": "Fit All-Star classifier",
      "operation": "binary_classification",
      "required": true,
      "inputs": [
        "model_data.csv"
      ],
      "outputs": [
        "model.pkl",
        "predictions.csv"
      ],
      "requirements": [
        "Apply fixed split, scaling, classifier, threshold."
      ],
      "parameters": {}
    },
    {
      "id": "evaluate",
      "name": "Compute overall metrics",
      "operation": "classification_evaluation",
      "required": true,
      "inputs": [
        "predictions.csv"
      ],
      "outputs": [
        "metrics.json"
      ],
      "requirements": [
        "Compute accuracy, precision, recall, F1, ROC AUC."
      ],
      "parameters": {}
    },
    {
      "id": "positions",
      "name": "Compute position diagnostics",
      "operation": "grouped_evaluation",
      "required": true,
      "inputs": [
        "predictions.csv"
      ],
      "outputs": [
        "position_model_summary.csv"
      ],
      "requirements": [
        "Compute position test counts and rates."
      ],
      "parameters": {}
    },
    {
      "id": "calibration",
      "name": "Compute calibration bins",
      "operation": "calibration_evaluation",
      "required": true,
      "inputs": [
        "predictions.csv"
      ],
      "outputs": [
        "calibration_bins.csv"
      ],
      "requirements": [
        "Compute five equal-width probability bins."
      ],
      "parameters": {}
    },
    {
      "id": "report",
      "name": "Synthesize model diagnostics",
      "operation": "multi_input_report",
      "required": true,
      "inputs": [
        "metrics.json",
        "position_model_summary.csv",
        "calibration_bins.csv"
      ],
      "outputs": [
        "allstar_report.json"
      ],
      "requirements": [
        "Consume all three diagnostics."
      ],
      "parameters": {}
    }
  ],
