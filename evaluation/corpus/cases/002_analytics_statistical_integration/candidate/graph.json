{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "002_analytics_statistical_integration",
  "benchmark_revision": "batch-05",
  "review_status": "author_review_pending",
  "title": "Linear treatment-score change analysis",
  "domain": "experimental_analytics",
  "family_id": "treatment_change_contrasts",
  "topology": "linear",
  "inputs": [
    {
      "id": "input:data.csv",
      "path": "inputs/data.csv",
      "format": "csv",
      "required_columns": [
        "subject_id",
        "group",
        "baseline_score",
        "post_score",
        "age",
        "region",
        "sessions_attended",
        "outcome"
      ]
    }
  ],
  "tasks": [
    {
      "id": "validate",
      "name": "Validate subject records",
      "operation": "source_validation",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "subjects_clean.csv"
      ],
      "requirements": [
        "Validate IDs, scores, measures, and binary outcome."
      ],
      "parameters": {}
    },
    {
      "id": "changes",
      "name": "Derive subject changes",
      "operation": "feature_engineering",
      "required": true,
      "inputs": [
        "subjects_clean.csv"
      ],
      "outputs": [
        "subject_changes.csv"
      ],
      "requirements": [
        "Compute exact change and improvement flag."
      ],
      "parameters": {}
    },
    {
      "id": "summarize",
      "name": "Summarize experimental groups",
      "operation": "grouped_aggregation",
      "required": true,
      "inputs": [
        "subject_changes.csv"
      ],
      "outputs": [
        "group_summary.csv"
      ],
      "requirements": [
        "Compute declared counts, rates, means, and sample standard deviations."
      ],
      "parameters": {}
    },
    {
      "id": "contrast",
      "name": "Contrast treatments with Control",
      "operation": "statistical_contrast",
      "required": true,
      "inputs": [
        "group_summary.csv"
      ],
      "outputs": [
        "treatment_contrasts.csv",
        "contrast_context.json"
      ],
      "requirements": [
        "Compute contrasts from sufficient statistics and carry weighted context forward."
      ],
      "parameters": {}
    },
    {
      "id": "report",
      "name": "Publish experiment report",
      "operation": "aggregate_report",
      "required": true,
      "inputs": [
        "treatment_contrasts.csv",
        "contrast_context.json"
      ],
      "outputs": [
        "experiment_report.json"
      ],
      "requirements": [
        "Publish exactly the carried context."
      ],
      "parameters": {}
    }
  ],
  "artifacts": [
    {
      "id": "subjects_clean.csv",
      "path": "subjects_clean.csv",
      "format": "csv",
      "required_columns": [
        "subject_id",
        "group",
        "baseline_score",
        "post_score"
      ]
    },
    {
      "id": "subject_changes.csv",
      "path": "subject_changes.csv",
      "format": "csv",
      "required_columns": [
        "subject_id",
        "score_change",
        "improved"
      ]
    },
    {
      "id": "group_summary.csv",
      "path": "group_summary.csv",
      "format": "csv",
      "required_columns": [
        "group",
        "subject_count",
        "mean_change",
        "std_change"
      ]
    },
    {
      "id": "treatment_contrasts.csv",
      "path": "treatment_contrasts.csv",
      "format": "csv",
      "required_columns": [
        "treatment_group",
        "difference_in_mean_change",
        "standard_error",
        "ci95_low",
        "ci95_high"
      ]
    },
    {
      "id": "contrast_context.json",
      "path": "contrast_context.json",
      "format": "json",
      "required_columns": []
    },
    {
      "id": "experiment_report.json",
      "path": "experiment_report.json",
      "format": "json",
      "required_columns": []
    }
  ],
  "dependencies": [
    {
      "source": "validate",
      "target": "changes",
      "kind": "data",
      "artifacts": [
        "subjects_clean.csv"
      ]
    },
    {
      "source": "changes",
      "target": "summarize",
      "kind": "data",
      "artifacts": [
        "subject_changes.csv"
      ]
    },
    {
      "source": "summarize",
      "target": "contrast",
      "kind": "data",
      "artifacts": [
        "group_summary.csv"
      ]
    },
    {
      "source": "contrast",
      "target": "report",
      "kind": "data",
      "artifacts": [
        "treatment_contrasts.csv",
        "contrast_context.json"
      ]
    }
  ],
  "rq1_policy": {
    "task_matching": "reviewed_semantic_mapping",
    "allow_split_or_merge": true,
    "exact_node_count_required": false,
    "data_edges_require_artifact_binding": true,
    "unknown_semantics": "unassessed_not_pass"
  },
  "reference": {
    "entrypoint": "reference.py",
    "task_functions": {
      "validate": "experiment",
      "changes": "experiment",
      "summarize": "experiment",
      "contrast": "experiment",
      "report": "experiment"
    }
  },
  "numeric_tolerance": {
    "atol": 1e-06,
    "rtol": 1e-06
  }
}