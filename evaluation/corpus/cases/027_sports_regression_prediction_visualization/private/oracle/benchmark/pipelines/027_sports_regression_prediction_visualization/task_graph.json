      "name": "Integrate model features",
      "operation": "feature_join",
      "required": true,
      "inputs": [
        "performance_features.csv",
        "context_features.csv"
      ],
      "outputs": [
        "model_data.csv"
      ],
      "requirements": [
        "Join one-to-one by player ID."
      ],
      "parameters": {}
    },
    {
      "id": "market_fit",
      "name": "Fit market-value model",
      "operation": "ridge_regression",
      "required": true,
      "inputs": [
        "model_data.csv"
      ],
      "outputs": [
        "market_model.pkl",
        "market_predictions.csv"
      ],
      "requirements": [
        "Use fixed split, scaling, and Ridge."
      ],
      "parameters": {}
    },
    {
      "id": "allstar_fit",
      "name": "Fit All-Star model",
      "operation": "binary_classification",
      "required": true,
      "inputs": [
        "model_data.csv"
      ],
      "outputs": [
        "allstar_model.pkl",
        "allstar_predictions.csv"
      ],
      "requirements": [
        "Use fixed stratified split, scaling, model, threshold."
      ],
      "parameters": {}
    },
    {
      "id": "market_evaluate",
      "name": "Evaluate market model",
      "operation": "regression_evaluation",
      "required": true,
      "inputs": [
        "market_predictions.csv"
      ],
      "outputs": [
        "market_metrics.json"
      ],
      "requirements": [
        "Compute MAE, RMSE, and R2."
      ],
      "parameters": {}
    },
    {
      "id": "allstar_evaluate",
      "name": "Evaluate All-Star model",
      "operation": "classification_evaluation",
      "required": true,
      "inputs": [
        "allstar_predictions.csv"
      ],
      "outputs": [
        "allstar_metrics.json"
      ],
      "requirements": [
        "Compute five classification metrics."
      ],
      "parameters": {}
    },
    {
      "id": "report",
      "name": "Reconcile model results",
      "operation": "multi_input_report",
      "required": true,
      "inputs": [
        "market_metrics.json",
        "allstar_metrics.json"
      ],
      "outputs": [
        "dual_model_report.json"
      ],
      "requirements": [
        "Publish model identities and test counts."
      ],
      "parameters": {}
    }
  ],
