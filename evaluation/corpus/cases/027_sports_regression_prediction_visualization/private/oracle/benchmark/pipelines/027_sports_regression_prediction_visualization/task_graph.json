        "position",
        "games_played",
        "points_per_game",
        "assists_per_game",
        "rebounds_per_game",
        "minutes_per_game",
        "age",
        "experience_years",
        "salary_millions",
        "all_star",
        "injury_games_missed",
        "contract_year",
        "market_value",
        "win_shares"
      ]
    }
  ],
  "tasks": [
    {
      "id": "validate",
      "name": "Validate players",
      "operation": "source_validation",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "players_clean.csv"
      ],
      "requirements": [
        "Validate identifiers, targets, and required values."
      ],
      "parameters": {}
    },
    {
      "id": "performance",
      "name": "Derive performance features",
      "operation": "feature_engineering",
      "required": true,
      "inputs": [
        "players_clean.csv"
      ],
      "outputs": [
        "performance_features.csv"
      ],
      "requirements": [
        "Compute production and per-minute production."
      ],
      "parameters": {}
    },
    {
      "id": "context",
