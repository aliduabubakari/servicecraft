{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "027_sports_regression_prediction_visualization",
  "benchmark_revision": "batch-12",
  "review_status": "author_review_pending",
  "title": "Convergent player features feeding two supervised models",
  "domain": "sports",
