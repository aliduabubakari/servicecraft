    },
    {
      "index": 9,
      "source": "if not customers.customer_id.is_unique or not products.product_id.is_unique or (not orders.order_id.is_unique) or customers.customer_id.astype(str).str.strip().eq('').any() or products.product_id.astype(str).str.strip().eq('').any() or orders.order_id.astype(str).str.strip().eq('').any():\n    raise ValueError('customer, product, and order identifiers must be unique')",
