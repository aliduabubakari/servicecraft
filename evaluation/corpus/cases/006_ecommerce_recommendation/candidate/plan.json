      "outputs": []
    },
    {
      "index": 13,
      "source": "if (orders.quantity <= 0).any() or not products.rating.between(0, 5).all() or (not set(products.in_stock.unique()) <= {0, 1}):\n    raise ValueError('quantity, rating, or stock flag violates its declared bounds')",
