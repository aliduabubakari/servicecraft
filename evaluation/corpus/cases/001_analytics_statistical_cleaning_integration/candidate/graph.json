{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "001_analytics_statistical_cleaning_integration",
  "benchmark_revision": "batch-03",
  "review_status": "author_review_pending",
  "title": "Stock and market return integration with convergent validation",
  "domain": "finance",
  "family_id": "multisource_market_integration",
  "topology": "linear_to_fan_in",
  "inputs": [
    {
      "id": "input:stocks.csv",
      "path": "inputs/stocks.csv",
      "format": "csv",
      "required_columns": [
        "ticker",
        "sector",
        "date",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ]
    },
    {
      "id": "input:market_indices.csv",
      "path": "inputs/market_indices.csv",
      "format": "csv",
      "required_columns": [
        "date",
        "sp500",
        "nasdaq"
      ]
    }
  ],
  "tasks": [
    {
      "id": "validate_stocks",
      "name": "Validate and normalize the stock branch",
      "operation": "source_validation_cleaning",
      "required": true,
      "inputs": [
        "input:stocks.csv"
      ],
      "outputs": [
        "clean_stocks.csv",
        "stock_quality.json"
      ],
      "requirements": [
        "Validate stock keys, dates, finite values, and nonnegative bounds; normalize high/low using row extrema."
      ],
      "parameters": {}
    },
    {
      "id": "validate_market",
      "name": "Validate the market-index branch",
      "operation": "source_validation",
      "required": true,
      "inputs": [
        "input:market_indices.csv"
      ],
      "outputs": [
        "clean_market.csv",
        "market_quality.json"
      ],
      "requirements": [
        "Validate index dates, levels, and uniqueness independently of stocks."
      ],
      "parameters": {}
    },
    {
      "id": "integrate",
      "name": "Join return-enriched stock and market branches",
      "operation": "temporal_join",
      "required": true,
      "inputs": [
        "clean_stocks.csv",
        "stock_quality.json",
        "clean_market.csv",
        "market_quality.json"
      ],
      "outputs": [
        "market_panel.csv",
        "integration.json"
      ],
      "requirements": [
        "Compute returns before an inner date join and retain first-return missing values.",
        "Publish join reconciliation counts."
      ],
      "parameters": {
        "join": "inner",
        "cardinality": "many_to_one"
      }
    },
    {
      "id": "analyze",
      "name": "Compute ticker statistics and index relationships",
      "operation": "statistical_analysis",
      "required": true,
      "inputs": [
        "market_panel.csv",
        "integration.json"
      ],
      "outputs": [
        "ticker_statistics.csv",
        "market_relationships.csv"
      ],
      "requirements": [
        "Use complete-return rows, sample volatility, and Pearson correlation."
      ],
      "parameters": {}
    },
    {
      "id": "report",
      "name": "Publish the integrated market report",
      "operation": "aggregate_report",
      "required": true,
      "inputs": [
        "ticker_statistics.csv",
        "market_relationships.csv"
      ],
      "outputs": [
        "finance_report.json"
      ],
      "requirements": [
        "Publish derived counts and deterministically ranked tickers."
      ],
      "parameters": {}
    }
  ],
  "artifacts": [
    {
      "id": "clean_stocks.csv",
      "path": "clean_stocks.csv",
      "format": "csv",
      "required_columns": [
        "ticker",
        "sector",
        "date",
        "close"
      ]
    },
    {
      "id": "stock_quality.json",
      "path": "stock_quality.json",
      "format": "json",
      "required_columns": []
    },
    {
      "id": "clean_market.csv",
      "path": "clean_market.csv",
      "format": "csv",
      "required_columns": [
        "date",
        "sp500",
        "nasdaq"
      ]
    },
    {
      "id": "market_quality.json",
      "path": "market_quality.json",
      "format": "json",
      "required_columns": []
    },
    {
      "id": "market_panel.csv",
      "path": "market_panel.csv",
      "format": "csv",
      "required_columns": [
        "ticker",
        "date",
        "stock_return",
        "sp500_return",
        "nasdaq_return",
        "excess_sp500_return"
      ]
    },
    {
      "id": "integration.json",
      "path": "integration.json",
      "format": "json",
      "required_columns": []
    },
    {
      "id": "ticker_statistics.csv",
      "path": "ticker_statistics.csv",
      "format": "csv",
      "required_columns": [
        "ticker",
        "sector",
        "observations",
        "mean_return",
        "volatility",
        "mean_excess_sp500_return"
      ]
    },
    {
      "id": "market_relationships.csv",
      "path": "market_relationships.csv",
      "format": "csv",
      "required_columns": [
        "ticker",
        "sp500_correlation",
        "nasdaq_correlation"
      ]
    },
    {
      "id": "finance_report.json",
      "path": "finance_report.json",
      "format": "json",
      "required_columns": []
    }
  ],
  "dependencies": [
    {
      "source": "validate_market",
      "target": "integrate",
      "kind": "data",
      "artifacts": [
        "clean_market.csv",
        "market_quality.json"
      ]
    },
    {
      "source": "validate_stocks",
      "target": "integrate",
      "kind": "data",
      "artifacts": [
        "clean_stocks.csv",
        "stock_quality.json"
      ]
    },
    {
      "source": "integrate",
      "target": "analyze",
      "kind": "data",
      "artifacts": [
        "market_panel.csv",
        "integration.json"
      ]
    },
    {
      "source": "analyze",
      "target": "report",
      "kind": "data",
      "artifacts": [
        "ticker_statistics.csv",
        "market_relationships.csv"
      ]
    }
  ],
  "rq1_policy": {
    "task_matching": "reviewed_semantic_mapping",
    "allow_split_or_merge": true,
    "exact_node_count_required": false,
    "data_edges_require_artifact_binding": true,
    "unknown_semantics": "unassessed_not_pass"
  },
  "reference": {
    "entrypoint": "reference.py",
    "task_functions": {
      "validate_stocks": "finance",
      "validate_market": "finance",
      "integrate": "finance",
      "analyze": "finance",
      "report": "finance"
    }
  },
  "numeric_tolerance": {
    "atol": 1e-06,
    "rtol": 1e-06
  }
}