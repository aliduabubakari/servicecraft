{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "018_sports_clustering_visualization_integration",
  "benchmark_revision": "batch-07",
  "review_status": "author_review_pending",
  "title": "Player clustering with three post-cluster views",
  "domain": "sports",
