      "operation": "cluster_profiling",
      "required": true,
      "inputs": [
        "player_clusters.csv",
        "cluster_model.pkl"
      ],
      "outputs": [
        "cluster_profiles.csv"
      ],
      "requirements": [
        "Compute declared counts/means."
      ],
      "parameters": {}
    },
    {
      "id": "team_mix",
      "name": "Compute team cluster mix",
      "operation": "grouped_aggregation",
      "required": true,
      "inputs": [
        "player_clusters.csv"
      ],
      "outputs": [
        "team_cluster_mix.csv"
      ],
      "requirements": [
        "Compute counts and within-team shares."
      ],
      "parameters": {}
    },
    {
      "id": "plot_data",
      "name": "Prepare PCA plot data",
      "operation": "dimensionality_reduction",
      "required": true,
      "inputs": [
        "player_clusters.csv",
        "cluster_model.pkl"
      ],
      "outputs": [
        "cluster_plot_data.csv"
      ],
      "requirements": [
        "Compute deterministic PC1/PC2."
      ],
      "parameters": {}
    }
