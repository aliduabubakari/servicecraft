      "path": "inputs/data.csv",
      "format": "csv",
      "required_columns": [
        "player_id",
        "team",
        "position",
        "points_per_game",
        "assists_per_game",
        "rebounds_per_game",
        "minutes_per_game",
        "play_style_score",
        "efficiency_rating",
        "usage_rate"
      ]
    }
  ],
  "tasks": [
    {
      "id": "validate",
      "name": "Validate players",
      "operation": "source_validation",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "players_clean.csv"
      ],
      "requirements": [
        "Validate unique IDs and finite fields."
      ],
      "parameters": {}
    },
    {
      "id": "features",
      "name": "Derive cluster features",
      "operation": "feature_engineering",
      "required": true,
      "inputs": [
        "players_clean.csv"
      ],
      "outputs": [
        "cluster_features.csv"
      ],
      "requirements": [
        "Compute production index and retain ordered features."
      ],
      "parameters": {}
    },
    {
      "id": "cluster",
      "name": "Fit canonical clusters",
      "operation": "kmeans_clustering",
      "required": true,
      "inputs": [
        "cluster_features.csv"
      ],
      "outputs": [
        "player_clusters.csv",
        "cluster_model.pkl"
