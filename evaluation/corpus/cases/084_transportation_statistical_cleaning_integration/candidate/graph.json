      "operation": "deterministic_ranking",
      "required": true,
      "inputs": [
        "route_scores.csv"
      ],
      "outputs": [
        "ranked_routes.csv"
      ],
      "requirements": [
        "Rank combined score descending with route tie-break."
      ],
      "parameters": {}
    },
    {
      "id": "report",
      "name": "Publish route report",
      "operation": "ranking_report",
      "required": true,
      "inputs": [
        "ranked_routes.csv"
      ],
      "outputs": [
        "route_report.json"
      ],
      "requirements": [
        "Publish counts and top route/score."
      ],
      "parameters": {}
    }
  ],
  "artifacts": [
