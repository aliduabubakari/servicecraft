  "title": "Convergent route reliability and satisfaction scoring",
  "domain": "transportation",
  "family_id": "route_service_scoring",
  "topology": "linear_to_fan_in",
  "inputs": [
    {
      "id": "input:data.csv",
      "path": "inputs/data.csv",
      "format": "csv",
      "required_columns": [
        "trip_id",
        "route",
        "vehicle_type",
        "distance_km",
        "passengers",
        "delay_minutes",
        "on_time_pct",
        "passenger_satisfaction"
      ]
    }
  ],
  "tasks": [
    {
      "id": "reliability",
      "name": "Summarize route reliability",
      "operation": "grouped_aggregation",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "route_reliability.csv"
      ],
      "requirements": [
        "Validate trips and compute reliability measures."
      ],
      "parameters": {}
    },
    {
      "id": "satisfaction",
      "name": "Summarize route satisfaction",
      "operation": "grouped_aggregation",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "route_satisfaction.csv"
      ],
      "requirements": [
        "Validate trips and compute satisfaction measures."
      ],
      "parameters": {}
    },
    {
      "id": "integrate",
      "name": "Integrate route measures",
      "operation": "one_to_one_join",
      "required": true,
      "inputs": [
        "route_reliability.csv",
        "route_satisfaction.csv"
      ],
      "outputs": [
        "route_scores.csv"
      ],
      "requirements": [
        "Join reconciled counts and compute normalized combined score."
      ],
      "parameters": {}
    },
    {
      "id": "rank",
