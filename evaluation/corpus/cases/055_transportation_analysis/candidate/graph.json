      ]
    },
    {
      "id": "trip_features.csv",
      "path": "trip_features.csv",
      "format": "csv",
      "required_columns": [
        "trip_id",
        "fare_per_passenger",
        "distance_holiday_interaction"
      ]
    },
    {
      "id": "train.csv",
      "path": "train.csv",
      "format": "csv",
      "required_columns": [
        "trip_id",
        "delay_minutes"
      ]
    },
    {
      "id": "test.csv",
      "path": "test.csv",
      "format": "csv",
      "required_columns": [
        "trip_id",
        "delay_minutes"
      ]
