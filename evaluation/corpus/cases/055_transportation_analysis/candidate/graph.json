    {
      "id": "predictions.csv",
      "path": "predictions.csv",
      "format": "csv",
      "required_columns": [
        "trip_id",
        "actual_delay_minutes",
        "predicted_delay_minutes"
      ]
    },
    {
      "id": "metrics.json",
      "path": "metrics.json",
      "format": "json",
      "required_columns": []
    },
    {
      "id": "delay_report.json",
      "path": "delay_report.json",
      "format": "json",
      "required_columns": []
    }
  ],
  "dependencies": [
    {
      "source": "validate",
      "target": "features",
      "kind": "data",
      "artifacts": [
        "trips_clean.csv"
      ]
    },
    {
