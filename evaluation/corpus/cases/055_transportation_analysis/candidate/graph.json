    "exact_node_count_required": false,
    "data_edges_require_artifact_binding": true,
    "unknown_semantics": "unassessed_not_pass"
  },
  "reference": {
    "entrypoint": "reference.py",
    "task_functions": {
      "validate": "transportation",
      "features": "transportation",
      "split": "transportation",
      "fit_predict": "transportation",
      "evaluate": "transportation",
      "report": "transportation"
    }
  },
  "numeric_tolerance": {
