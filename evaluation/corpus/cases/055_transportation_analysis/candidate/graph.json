{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "055_transportation_analysis",
  "benchmark_revision": "batch-04",
  "review_status": "author_review_pending",
  "title": "Linear transportation delay regression",
  "domain": "transportation",
  "family_id": "trip_delay_regression",
  "topology": "linear",
  "inputs": [
    {
      "id": "input:data.csv",
      "path": "inputs/data.csv",
      "format": "csv",
      "required_columns": [
        "trip_id",
        "route",
        "vehicle_type",
        "departure_hour",
        "distance_km",
        "passengers",
        "fare_amount",
        "delay_minutes",
        "day_of_week",
        "is_holiday",
        "weather_condition"
      ]
    }
  ],
  "tasks": [
    {
      "id": "validate",
      "name": "Validate trip records",
      "operation": "source_validation",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "trips_clean.csv"
      ],
      "requirements": [
        "Validate trip keys, bounds, and flags."
      ],
      "parameters": {}
    },
    {
      "id": "features",
      "name": "Derive trip predictors",
      "operation": "feature_engineering",
      "required": true,
      "inputs": [
        "trips_clean.csv"
      ],
      "outputs": [
        "trip_features.csv"
      ],
      "requirements": [
        "Compute fare-per-passenger and holiday-distance interaction."
      ],
      "parameters": {}
    },
    {
      "id": "split",
      "name": "Create reproducible partitions",
      "operation": "random_split",
      "required": true,
      "inputs": [
        "trip_features.csv"
      ],
      "outputs": [
        "train.csv",
        "test.csv"
      ],
      "requirements": [
        "Use an 80/20 split with seed 42."
      ],
      "parameters": {
        "test_fraction": 0.2,
        "random_state": 42
      }
    },
    {
      "id": "fit_predict",
      "name": "Fit delay Ridge pipeline",
      "operation": "supervised_regression",
      "required": true,
      "inputs": [
        "train.csv",
        "test.csv"
      ],
      "outputs": [
        "model.pkl",
        "predictions.csv"
      ],
      "requirements": [
        "Fit scaler/model on training only and predict all test rows."
      ],
      "parameters": {}
    },
    {
      "id": "evaluate",
      "name": "Evaluate held-out delay",
      "operation": "regression_evaluation",
      "required": true,
      "inputs": [
        "predictions.csv"
      ],
      "outputs": [
        "metrics.json"
      ],
      "requirements": [
        "Compute MAE/RMSE and retain metadata."
      ],
      "parameters": {}
    },
    {
      "id": "report",
      "name": "Publish delay report",
      "operation": "model_report",
      "required": true,
      "inputs": [
        "metrics.json"
      ],
      "outputs": [
        "delay_report.json"
      ],
      "requirements": [
        "Publish exactly the computed metrics."
      ],
      "parameters": {}
    }
  ],
  "artifacts": [
