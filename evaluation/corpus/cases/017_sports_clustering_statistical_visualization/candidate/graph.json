{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "017_sports_clustering_statistical_visualization",
  "benchmark_revision": "batch-06",
  "review_status": "author_review_pending",
  "title": "Convergent player-style features with multi-view cluster analysis",
  "domain": "sports",
  "family_id": "player_style_multiview_clustering",
  "topology": "fan_in_fan_out",
  "inputs": [
