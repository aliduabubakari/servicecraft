        "player_id",
        "team",
        "position",
        "points_per_game",
        "assists_per_game",
        "rebounds_per_game",
        "play_style_score",
        "efficiency_rating",
        "usage_rate",
        "field_goal_pct",
        "three_point_pct",
        "free_throw_pct"
      ]
    }
  ],
  "tasks": [
    {
      "id": "validate",
      "name": "Validate players",
      "operation": "source_validation",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "players_clean.csv"
      ],
      "requirements": [
        "Validate keys and finite style/shooting fields."
      ],
      "parameters": {}
    },
    {
      "id": "shooting",
      "name": "Derive shooting features",
      "operation": "feature_engineering",
      "required": true,
      "inputs": [
        "players_clean.csv"
      ],
      "outputs": [
        "shooting_features.csv"
      ],
      "requirements": [
        "Compute three percentages and shooting composite."
      ],
      "parameters": {}
    },
    {
      "id": "playmaking",
      "name": "Derive playmaking features",
      "operation": "feature_engineering",
      "required": true,
      "inputs": [
        "players_clean.csv"
      ],
      "outputs": [
        "playmaking_features.csv"
      ],
      "requirements": [
        "Compute production index and retain six style measures."
      ],
      "parameters": {}
    },
    {
      "id": "integrate",
      "name": "Join style branches",
      "operation": "feature_join",
      "required": true,
      "inputs": [
        "players_clean.csv",
        "shooting_features.csv",
        "playmaking_features.csv"
      ],
      "outputs": [
        "style_features.csv"
      ],
      "requirements": [
        "Join branches one-to-one by player."
      ],
      "parameters": {}
    },
    {
      "id": "cluster",
      "name": "Fit canonical style clusters",
      "operation": "kmeans_clustering",
      "required": true,
      "inputs": [
        "style_features.csv"
      ],
      "outputs": [
        "player_clusters.csv",
        "cluster_model.pkl"
      ],
      "requirements": [
        "Scale, fit fixed K-means, canonicalize, and retain feature fields."
      ],
      "parameters": {}
    },
    {
      "id": "profiles",
      "name": "Profile clusters",
      "operation": "cluster_profiling",
      "required": true,
      "inputs": [
        "player_clusters.csv",
        "cluster_model.pkl"
      ],
      "outputs": [
        "cluster_profiles.csv"
      ],
      "requirements": [
        "Compute declared cluster means/counts."
      ],
      "parameters": {}
    },
    {
      "id": "positions",
      "name": "Compute position mix",
      "operation": "grouped_aggregation",
      "required": true,
      "inputs": [
        "player_clusters.csv"
      ],
      "outputs": [
        "position_cluster_mix.csv"
      ],
      "requirements": [
        "Compute position/cluster counts and shares."
      ],
      "parameters": {}
    },
    {
      "id": "scatter",
      "name": "Prepare PCA scatter data",
      "operation": "dimensionality_reduction",
      "required": true,
      "inputs": [
        "player_clusters.csv",
        "cluster_model.pkl"
      ],
      "outputs": [
        "cluster_scatter_data.csv"
      ],
      "requirements": [
        "Compute deterministic two-component PCA coordinates."
      ],
      "parameters": {}
    },
    {
      "id": "report",
      "name": "Synthesize style analysis",
      "operation": "multi_input_report",
      "required": true,
      "inputs": [
        "cluster_profiles.csv",
        "position_cluster_mix.csv",
        "cluster_scatter_data.csv"
      ],
      "outputs": [
        "style_report.json"
      ],
      "requirements": [
        "Consume all three analytical views."
      ],
      "parameters": {}
    }
  ],
