        "plan": 27
      },
      "writes": [
        "moq"
      ],
      "outputs": []
    },
    {
      "index": 30,
      "source": "plan['suggested_order_quantity'] = np.where(raw > 0, np.ceil(raw / moq).astype(int) * moq, 0)",
      "dependencies": {
        "moq": 29,
        "raw": 28,
        "plan": 27
      },
      "writes": [
        "plan"
      ],
      "outputs": []
    },
    {
      "index": 31,
      "source": "plan['reorder_required'] = (plan.suggested_order_quantity > 0).astype(int)",
      "dependencies": {
        "plan": 30
      },
      "writes": [
        "plan"
      ],
      "outputs": []
    },
    {
      "index": 32,
      "source": "columns = ['sku_id', 'product_name', 'supplier', 'lead_time_days', 'current_stock', 'minimum_order_qty', 'mean_daily_demand', 'std_daily_demand', 'window_quantity', 'target_stock', 'suggested_order_quantity', 'reorder_required']",
      "dependencies": {},
      "writes": [
        "columns"
      ],
      "outputs": []
    },
    {
      "index": 33,
      "source": "plan = plan[columns].sort_values('sku_id').reset_index(drop=True)",
      "dependencies": {
        "columns": 32,
        "plan": 31
      },
      "writes": [
