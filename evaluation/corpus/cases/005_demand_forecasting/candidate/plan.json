      "writes": [
        "suppliers"
      ],
      "outputs": []
    },
    {
      "index": 9,
      "source": "if not inventory.sku_id.is_unique or not sales.order_id.is_unique or (not suppliers.supplier_name.is_unique) or inventory.sku_id.astype(str).str.strip().eq('').any() or sales.order_id.astype(str).str.strip().eq('').any():\n    raise ValueError('inventory, order, and supplier identifiers must be unique')",
      "dependencies": {
