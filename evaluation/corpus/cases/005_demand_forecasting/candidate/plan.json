        "end": 17
      },
      "writes": [
        "start"
      ],
      "outputs": []
    },
    {
      "index": 19,
      "source": "recent = sales[(sales.order_date.dt.normalize() >= start) & (sales.order_date.dt.normalize() <= end)].copy()",
      "dependencies": {
        "start": 18,
        "end": 17,
        "sales": 16
      },
      "writes": [
        "recent"
      ],
      "outputs": []
    },
    {
      "index": 20,
      "source": "recent['date'] = recent.order_date.dt.normalize()",
      "dependencies": {
        "recent": 19
      },
      "writes": [
        "recent"
      ],
      "outputs": []
    },
    {
      "index": 21,
      "source": "daily = recent.groupby(['sku_id', 'date'], as_index=False).quantity.sum()",
      "dependencies": {
        "recent": 20
      },
      "writes": [
        "daily"
      ],
      "outputs": []
    },
    {
      "index": 22,
      "source": "grid = pd.MultiIndex.from_product([sorted(inventory.sku_id), pd.date_range(start, end)], names=['sku_id', 'date']).to_frame(index=False)",
      "dependencies": {
        "end": 17,
        "inventory": 15,
        "start": 18
      },
      "writes": [
        "grid"
      ],
      "outputs": []
    },
    {
      "index": 23,
      "source": "daily = grid.merge(daily, on=['sku_id', 'date'], how='left').fillna({'quantity': 0}).sort_values(['sku_id', 'date'])",
      "dependencies": {
        "daily": 21,
        "grid": 22
      },
      "writes": [
        "daily"
      ],
      "outputs": []
    },
    {
      "index": 24,
      "source": "daily.to_csv(out / 'daily_demand.csv', index=False, date_format='%Y-%m-%d')",
      "dependencies": {
        "daily": 23
      },
      "writes": [],
      "outputs": [
        "daily_demand.csv"
      ]
    },
    {
      "index": 25,
      "source": "demand = daily.groupby('sku_id', as_index=False).agg(mean_daily_demand=('quantity', 'mean'), std_daily_demand=('quantity', lambda x: x.std(ddof=0)), window_quantity=('quantity', 'sum'))",
      "dependencies": {
        "daily": 23
      },
      "writes": [
        "demand"
      ],
      "outputs": []
    },
    {
      "index": 26,
      "source": "plan = inventory[ic].merge(demand, on='sku_id', validate='one_to_one').merge(suppliers[uc], left_on='supplier', right_on='supplier_name', validate='many_to_one')",
      "dependencies": {
        "suppliers": 15,
        "demand": 25,
        "ic": 3,
        "inventory": 15,
        "uc": 5
      },
      "writes": [
        "plan"
      ],
      "outputs": []
    },
    {
      "index": 27,
      "source": "plan['target_stock'] = plan.mean_daily_demand * plan.lead_time_days + 1.645 * plan.std_daily_demand * np.sqrt(plan.lead_time_days)",
      "dependencies": {
        "plan": 26
      },
      "writes": [
        "plan"
      ],
      "outputs": []
    },
    {
      "index": 28,
      "source": "raw = np.maximum(0, np.ceil(plan.target_stock - plan.current_stock)).astype(int)",
