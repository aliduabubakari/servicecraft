        "suppliers": 8,
        "inventory": 6
      },
      "writes": [
        "inventory",
        "sales",
        "suppliers"
      ],
      "outputs": []
    },
    {
      "index": 10,
      "source": "if not set(sales.sku_id) <= set(inventory.sku_id) or not set(inventory.supplier) <= set(suppliers.supplier_name):\n    raise ValueError('sales and supplier keys do not reconcile')",
      "dependencies": {
        "sales": 9,
        "suppliers": 9,
        "inventory": 9
