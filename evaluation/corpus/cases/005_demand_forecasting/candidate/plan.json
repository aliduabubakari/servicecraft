    {
      "index": 13,
      "source": "finite(suppliers, ['minimum_order_qty'], 'suppliers.csv')",
      "dependencies": {
        "suppliers": 10
      },
      "writes": [
        "suppliers"
      ],
      "outputs": []
    },
    {
      "index": 14,
      "source": "if (inventory[['lead_time_days', 'current_stock']].to_numpy() < 0).any() or (sales.quantity < 0).any() or (suppliers.minimum_order_qty <= 0).any():\n    raise ValueError('inventory planning measures violate nonnegative/positive bounds')",
      "dependencies": {
        "inventory": 11,
        "sales": 12,
        "suppliers": 13
      },
      "writes": [
        "inventory",
        "sales",
        "suppliers"
      ],
      "outputs": []
    },
    {
      "index": 15,
      "source": "if not inventory.lead_time_days.map(lambda value: float(value).is_integer()).all() or not suppliers.minimum_order_qty.map(lambda value: float(value).is_integer()).all():\n    raise ValueError('lead_time_days and minimum_order_qty must be integers')",
      "dependencies": {
        "suppliers": 14,
        "inventory": 14
      },
      "writes": [
        "inventory",
        "suppliers"
      ],
      "outputs": []
    },
    {
      "index": 16,
      "source": "sales['order_date'] = pd.to_datetime(sales.order_date, errors='raise')",
      "dependencies": {
        "sales": 14
      },
      "writes": [
        "sales"
      ],
      "outputs": []
    },
    {
      "index": 17,
      "source": "end = sales.order_date.max().normalize()",
      "dependencies": {
        "sales": 16
      },
      "writes": [
        "end"
      ],
      "outputs": []
    },
    {
      "index": 18,
      "source": "start = end - pd.Timedelta(days=89)",
