      "writes": [
        "inventory",
        "sales",
        "suppliers"
      ],
      "outputs": []
    },
    {
      "index": 11,
      "source": "finite(inventory, ['lead_time_days', 'current_stock'], 'inventory.csv')",
      "dependencies": {
        "inventory": 10
      },
      "writes": [
        "inventory"
      ],
      "outputs": []
    },
    {
      "index": 12,
      "source": "finite(sales, ['quantity'], 'sales_orders.csv')",
