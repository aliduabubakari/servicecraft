      "source": "report = {'window_start': start.strftime('%Y-%m-%d'), 'window_end': end.strftime('%Y-%m-%d'), 'window_days': 90, 'service_z': 1.645, 'skus': len(plan), 'reorder_skus': int(plan.reorder_required.sum()), 'total_suggested_units': int(plan.suggested_order_quantity.sum())}",
      "dependencies": {
