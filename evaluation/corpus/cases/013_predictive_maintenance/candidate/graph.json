{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "013_predictive_maintenance",
  "benchmark_revision": "batch-04",
  "review_status": "author_review_pending",
  "title": "Temporal maintenance features with dual-horizon failure models",
  "domain": "manufacturing",
  "family_id": "temporal_maintenance_multioutput",
  "topology": "fan_in_fan_out",
  "inputs": [
    {
      "id": "input:sensor_readings.csv",
      "path": "inputs/sensor_readings.csv",
      "format": "csv",
      "required_columns": [
        "machine_id",
        "machine_type",
        "timestamp",
        "temperature_c",
        "vibration_mm_s",
        "pressure_bar",
        "rpm",
        "power_consumption_kw",
        "noise_db",
        "humidity_pct",
        "is_failure",
        "failure_within_24h",
        "failure_within_7d"
      ]
    }
  ],
  "tasks": [
    {
      "id": "validate",
      "name": "Validate ordered machine series",
      "operation": "temporal_validation",
      "required": true,
      "inputs": [
        "input:sensor_readings.csv"
      ],
      "outputs": [
        "sensor_clean.csv"
      ],
      "requirements": [
        "Validate keys, continuity, sensors, and binary targets."
      ],
      "parameters": {}
    },
    {
      "id": "temporal",
      "name": "Derive lag and rolling features",
      "operation": "temporal_features",
      "required": true,
      "inputs": [
        "sensor_clean.csv"
      ],
      "outputs": [
        "temporal_features.csv"
      ],
      "requirements": [
        "Use shift(1) and prior 24-hour windows for three sensors."
      ],
      "parameters": {}
    },
    {
      "id": "baselines",
      "name": "Derive expanding machine baselines",
      "operation": "expanding_features",
      "required": true,
      "inputs": [
        "sensor_clean.csv"
      ],
      "outputs": [
        "expanding_baselines.csv"
      ],
      "requirements": [
        "Use shifted expanding mean/population standard deviation with 24-row minimum."
      ],
      "parameters": {}
    },
    {
      "id": "integrate",
      "name": "Join past-only feature branches",
      "operation": "feature_join",
      "required": true,
      "inputs": [
        "sensor_clean.csv",
        "temporal_features.csv",
        "expanding_baselines.csv"
      ],
      "outputs": [
        "maintenance_features.csv"
      ],
      "requirements": [
        "Join one-to-one, remove incomplete derived rows, and sort chronologically."
      ],
      "parameters": {}
    },
    {
      "id": "model24h",
      "name": "Fit 24-hour failure model",
      "operation": "binary_classification",
      "required": true,
      "inputs": [
        "maintenance_features.csv"
      ],
      "outputs": [
        "failure24h_model.pkl",
        "failure24h_predictions.csv",
        "failure24h_metrics.json"
      ],
      "requirements": [
        "Apply chronological split, train-only scaling, fixed classifier, and held-out metrics."
      ],
      "parameters": {}
    },
    {
      "id": "model7d",
      "name": "Fit seven-day failure model",
      "operation": "binary_classification",
      "required": true,
      "inputs": [
        "maintenance_features.csv"
      ],
      "outputs": [
        "failure7d_model.pkl",
        "failure7d_predictions.csv",
        "failure7d_metrics.json"
      ],
      "requirements": [
        "Apply chronological split, train-only scaling, fixed classifier, and held-out metrics."
      ],
      "parameters": {}
    },
    {
      "id": "risk",
      "name": "Summarize risk by machine",
      "operation": "grouped_aggregation",
      "required": true,
      "inputs": [
        "maintenance_features.csv"
      ],
      "outputs": [
        "machine_risk_summary.csv"
      ],
      "requirements": [
        "Compute declared counts, rates, and sensor means."
      ],
      "parameters": {}
    },
    {
      "id": "report",
      "name": "Synthesize maintenance outputs",
      "operation": "multi_input_report",
      "required": true,
      "inputs": [
        "failure24h_metrics.json",
        "failure7d_metrics.json",
        "machine_risk_summary.csv"
      ],
      "outputs": [
        "maintenance_report.json"
      ],
      "requirements": [
        "Consume all analytical branches and publish nested results."
      ],
      "parameters": {}
    }
  ],
  "artifacts": [
    {
      "id": "sensor_clean.csv",
      "path": "sensor_clean.csv",
      "format": "csv",
      "required_columns": [
        "machine_id",
        "timestamp",
        "failure_within_24h",
        "failure_within_7d"
      ]
    },
    {
      "id": "temporal_features.csv",
      "path": "temporal_features.csv",
      "format": "csv",
      "required_columns": [
        "machine_id",
        "timestamp",
        "temperature_c_lag1",
        "temperature_c_rolling24_mean"
      ]
    },
    {
      "id": "expanding_baselines.csv",
      "path": "expanding_baselines.csv",
      "format": "csv",
      "required_columns": [
        "machine_id",
        "timestamp",
        "temperature_c_prior_mean",
        "temperature_c_prior_std"
      ]
    },
    {
      "id": "maintenance_features.csv",
      "path": "maintenance_features.csv",
      "format": "csv",
      "required_columns": [
        "machine_id",
        "timestamp",
        "temperature_c_lag1",
        "temperature_c_prior_mean"
      ]
    },
    {
      "id": "failure24h_model.pkl",
      "path": "failure24h_model.pkl",
      "format": "pkl",
      "required_columns": []
    },
    {
      "id": "failure24h_predictions.csv",
      "path": "failure24h_predictions.csv",
      "format": "csv",
      "required_columns": [
        "machine_id",
        "timestamp",
        "actual",
        "probability",
        "predicted"
      ]
    },
    {
      "id": "failure24h_metrics.json",
      "path": "failure24h_metrics.json",
      "format": "json",
      "required_columns": []
    },
    {
      "id": "failure7d_model.pkl",
      "path": "failure7d_model.pkl",
      "format": "pkl",
      "required_columns": []
    },
    {
      "id": "failure7d_predictions.csv",
      "path": "failure7d_predictions.csv",
      "format": "csv",
      "required_columns": [
        "machine_id",
        "timestamp",
        "actual",
        "probability",
        "predicted"
      ]
    },
    {
      "id": "failure7d_metrics.json",
      "path": "failure7d_metrics.json",
      "format": "json",
      "required_columns": []
    },
    {
      "id": "machine_risk_summary.csv",
      "path": "machine_risk_summary.csv",
      "format": "csv",
      "required_columns": [
        "machine_id",
        "observations",
        "failure_count",
        "failure24h_rate",
        "failure7d_rate"
      ]
    },
    {
      "id": "maintenance_report.json",
      "path": "maintenance_report.json",
      "format": "json",
      "required_columns": []
    }
  ],
  "dependencies": [
    {
