    {
      "index": 18,
      "source": "integrated = clean.merge(temporal, on=['machine_id', 'timestamp'], validate='one_to_one').merge(baseline, on=['machine_id', 'timestamp'], validate='one_to_one').dropna().sort_values(['timestamp', 'machine_id']).reset_index(drop=True)",
