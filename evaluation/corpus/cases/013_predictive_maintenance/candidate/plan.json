      "outputs": []
    },
    {
      "index": 13,
      "source": "for column in ['temperature_c', 'vibration_mm_s', 'power_consumption_kw']:\n    grouped = clean.groupby('machine_id')[column]\n    temporal[f'{column}_lag1'] = grouped.shift(1)\n    temporal[f'{column}_rolling24_mean'] = grouped.transform(lambda s: s.shift(1).rolling(24, min_periods=24).mean())",
