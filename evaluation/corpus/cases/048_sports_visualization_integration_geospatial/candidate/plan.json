        "region_summary.csv"
      ]
    },
    {
      "index": 15,
      "source": "js(out / 'geography_report.json', {'players': len(g), 'regions': len(regions), 'largest_region': regions.sort_values(['player_count', 'region'], ascending=[False, True]).iloc[0].region})",
      "dependencies": {
        "g": 11,
        "regions": 13
      },
      "writes": [],
      "outputs": [
        "geography_report.json"
      ]
