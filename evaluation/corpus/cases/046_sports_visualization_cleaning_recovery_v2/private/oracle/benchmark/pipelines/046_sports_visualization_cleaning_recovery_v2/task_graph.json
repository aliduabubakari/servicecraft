    "task_functions": {
      "audit": "recovery_linear",
      "numeric": "recovery_linear",
      "categorical": "recovery_linear",
      "summarize": "recovery_linear",
      "report": "recovery_linear"
    }
  },
  "numeric_tolerance": {
    "atol": 1e-06,
    "rtol": 1e-06
  }
}
