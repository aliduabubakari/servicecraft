      ],
      "outputs": []
    },
    {
      "index": 21,
      "source": "for c in ['team', 'position']:\n    mask = n[c].isna()\n    recovered_categorical[c] = int(mask.sum())\n    counts = n[c].dropna().value_counts()\n    mode = sorted(counts[counts == counts.max()].index.astype(str))[0]\n    n.loc[mask, c] = mode",
      "dependencies": {
        "mask": 17,
        "c": 17,
        "n": 18,
        "recovered_categorical": 20
      },
      "writes": [
