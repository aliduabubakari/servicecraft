        "players_recovered.csv"
      ]
    },
    {
      "index": 23,
      "source": "summary = n.groupby('team', as_index=False).agg(player_count=('player_id', 'size'), mean_points=('points_per_game', 'mean'), mean_salary=('salary_millions', 'mean'), mean_experience=('experience_years', 'mean'), recovered_points=('missing_points_input', 'sum'), recovered_salary=('missing_salary_input', 'sum'), recovered_team=('missing_team_input', 'sum'), recovered_position=('missing_position_input', 'sum')).sort_values('team')",
      "dependencies": {
        "n": 21
      },
      "writes": [
