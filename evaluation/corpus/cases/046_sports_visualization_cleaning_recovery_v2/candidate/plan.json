        "d": 10
      },
      "writes": [
        "d"
      ],
      "outputs": []
    },
    {
      "index": 12,
      "source": "flags = ['missing_points_input', 'missing_salary_input', 'missing_team_input', 'missing_position_input']",
      "dependencies": {},
      "writes": [
        "flags"
      ],
      "outputs": []
    },
    {
      "index": 13,
      "source": "d[[*cols, *flags]].sort_values('player_id').to_csv(out / 'audited_players.csv', index=False)",
      "dependencies": {
        "d": 11,
        "cols": 2,
        "flags": 12
      },
      "writes": [],
