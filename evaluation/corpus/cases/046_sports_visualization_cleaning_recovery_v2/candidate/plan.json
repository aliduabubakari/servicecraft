{
  "steps": [
    {
      "index": 0,
      "source": "d = pd.read_csv(data / 'data.csv', keep_default_na=True)",
      "dependencies": {},
      "writes": [
        "d"
      ],
      "outputs": []
    },
    {
      "index": 1,
      "source": "cols = ['player_id', 'team', 'position', 'games_played', 'points_per_game', 'assists_per_game', 'rebounds_per_game', 'minutes_per_game', 'age', 'experience_years', 'salary_millions']",
      "dependencies": {},
      "writes": [
        "cols"
      ],
      "outputs": []
    },
    {
      "index": 2,
      "source": "if set(cols) - set(d):\n    raise ValueError('columns')",
      "dependencies": {
        "cols": 1,
        "d": 0
      },
      "writes": [
        "cols",
        "d"
      ],
      "outputs": []
    },
    {
      "index": 3,
      "source": "if not d.player_id.is_unique or d.player_id.astype(str).str.strip().eq('').any():\n    raise ValueError('id')",
      "dependencies": {
        "d": 2
      },
      "writes": [
        "d"
      ],
      "outputs": []
    },
    {
      "index": 4,
      "source": "for c in ['team', 'position']:\n    d[c] = d[c].replace('^\\\\s*$', np.nan, regex=True)",
      "dependencies": {
        "d": 3
      },
      "writes": [
        "c",
        "d"
      ],
      "outputs": []
    },
    {
      "index": 5,
      "source": "nums = [c for c in cols if c not in {'player_id', 'team', 'position'}]",
      "dependencies": {
        "cols": 2
      },
      "writes": [
        "nums"
      ],
      "outputs": []
    },
    {
      "index": 6,
      "source": "for c in nums:\n    d[c] = pd.to_numeric(d[c], errors='coerce')",
