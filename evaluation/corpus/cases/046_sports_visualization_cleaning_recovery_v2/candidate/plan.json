        "d": 4,
        "nums": 5,
        "c": 4
      },
      "writes": [
        "c",
        "d"
      ],
      "outputs": []
    },
    {
      "index": 7,
      "source": "audit = {'rows': len(d), 'missing': {c: int(d[c].isna().sum()) for c in cols}, 'total_missing': int(d[cols].isna().sum().sum())}",
      "dependencies": {
        "cols": 2,
        "d": 6
      },
      "writes": [
        "audit"
      ],
      "outputs": []
    },
    {
      "index": 8,
      "source": "d['missing_points_input'] = d.points_per_game.isna().astype(int)",
