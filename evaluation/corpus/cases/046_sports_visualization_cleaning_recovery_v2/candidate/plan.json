        "d": 6
      },
      "writes": [
        "d"
      ],
      "outputs": []
    },
    {
      "index": 9,
      "source": "d['missing_salary_input'] = d.salary_millions.isna().astype(int)",
      "dependencies": {
        "d": 8
      },
      "writes": [
        "d"
      ],
      "outputs": []
    },
    {
      "index": 10,
      "source": "d['missing_team_input'] = d.team.isna().astype(int)",
      "dependencies": {
        "d": 9
      },
      "writes": [
        "d"
      ],
      "outputs": []
    },
    {
      "index": 11,
      "source": "d['missing_position_input'] = d.position.isna().astype(int)",
