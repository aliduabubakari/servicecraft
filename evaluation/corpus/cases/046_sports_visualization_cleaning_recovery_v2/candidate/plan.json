    {
      "index": 15,
      "source": "n = d.copy()",
      "dependencies": {
        "d": 11
      },
      "writes": [
        "n"
      ],
      "outputs": []
    },
    {
      "index": 16,
      "source": "recovered_numeric = {}",
      "dependencies": {},
      "writes": [
        "recovered_numeric"
      ],
      "outputs": []
    },
    {
      "index": 17,
      "source": "for c in nums:\n    mask = n[c].isna()\n    recovered_numeric[c] = int(mask.sum())\n    group = n.groupby('position')[c].transform('median')\n    n.loc[mask, c] = group[mask]\n    n[c] = n[c].fillna(n[c].median())",
      "dependencies": {
        "recovered_numeric": 16,
        "c": 6,
        "nums": 5,
        "n": 15
      },
      "writes": [
        "c",
        "group",
        "mask",
        "n",
        "recovered_numeric"
      ],
      "outputs": []
    },
    {
      "index": 18,
      "source": "if not np.isfinite(n[nums].to_numpy(float)).all():\n    raise ValueError('numeric recovery')",
      "dependencies": {
        "nums": 5,
        "n": 17
      },
      "writes": [
        "n",
        "nums"
      ],
      "outputs": []
    },
    {
      "index": 19,
      "source": "n[[*cols, *flags]].sort_values('player_id').to_csv(out / 'numeric_recovered.csv', index=False)",
      "dependencies": {
        "n": 18,
        "cols": 2,
        "flags": 12
      },
      "writes": [],
      "outputs": [
