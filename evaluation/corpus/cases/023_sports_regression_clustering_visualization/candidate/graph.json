        "rebounds_per_game",
        "minutes_per_game",
        "age",
        "experience_years",
        "salary_millions",
        "play_style_score",
        "efficiency_rating",
        "usage_rate",
        "market_value",
        "win_shares"
      ]
    }
  ],
  "tasks": [
    {
      "id": "reg_prepare",
      "name": "Prepare regression data",
      "operation": "feature_selection",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "regression_features.csv"
      ],
      "requirements": [
        "Validate players and select target/predictors."
      ],
      "parameters": {}
    },
    {
      "id": "reg_fit",
      "name": "Fit market-value model",
      "operation": "supervised_regression",
      "required": true,
      "inputs": [
        "regression_features.csv"
      ],
      "outputs": [
        "market_value_model.pkl",
        "market_value_predictions.csv"
      ],
      "requirements": [
        "Apply fixed split, scaling, regression, and held-out predictions."
      ],
      "parameters": {}
    },
    {
      "id": "reg_evaluate",
      "name": "Evaluate market-value model",
      "operation": "regression_evaluation",
      "required": true,
      "inputs": [
        "market_value_predictions.csv"
      ],
      "outputs": [
        "market_value_metrics.json"
      ],
      "requirements": [
        "Compute MAE, RMSE, and R2 with metadata."
      ],
      "parameters": {}
    },
    {
      "id": "cluster_prepare",
      "name": "Prepare style features",
      "operation": "feature_selection",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "clustering_features.csv"
      ],
      "requirements": [
        "Validate players and select six ordered clustering features."
      ],
      "parameters": {}
    },
    {
      "id": "cluster_fit",
      "name": "Fit canonical player clusters",
      "operation": "kmeans_clustering",
      "required": true,
      "inputs": [
        "clustering_features.csv"
      ],
      "outputs": [
        "player_clusters.csv",
        "cluster_model.pkl"
      ],
      "requirements": [
        "Scale, fit fixed K-means, and canonicalize labels."
      ],
      "parameters": {}
    },
    {
      "id": "cluster_profile",
      "name": "Profile player clusters",
      "operation": "cluster_profiling",
      "required": true,
      "inputs": [
        "player_clusters.csv",
        "cluster_model.pkl"
      ],
      "outputs": [
        "cluster_profiles.csv",
        "cluster_report.json"
      ],
      "requirements": [
        "Compute profiles and silhouette report."
      ],
      "parameters": {}
    }
  ],
