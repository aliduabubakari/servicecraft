      ]
    },
    {
      "index": 22,
      "source": "js(out / 'route_report.json', {'routes': len(rank), 'trips': int(c.service_trip_count.sum()), 'top_route': rank.iloc[0].route, 'top_score': rank.iloc[0].route_score, 'total_profit': c.total_profit.sum()})",
      "dependencies": {
