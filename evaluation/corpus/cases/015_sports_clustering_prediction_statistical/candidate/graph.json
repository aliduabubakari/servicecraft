      ]
    },
    {
      "source": "cluster_fit",
      "target": "cluster_profile",
      "kind": "data",
      "artifacts": [
        "player_clusters.csv",
        "cluster_model.pkl"
      ]
    },
    {
      "source": "prediction_prepare",
      "target": "prediction_fit",
      "kind": "data",
      "artifacts": [
        "prediction_features.csv"
      ]
    },
    {
      "source": "prediction_fit",
      "target": "prediction_evaluate",
      "kind": "data",
      "artifacts": [
        "all_star_predictions.csv"
      ]
    }
  ],
  "rq1_policy": {
    "task_matching": "reviewed_semantic_mapping",
    "allow_split_or_merge": true,
