{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "015_sports_clustering_prediction_statistical",
  "benchmark_revision": "batch-04",
  "review_status": "author_review_pending",
  "title": "Independent player clustering and All-Star prediction",
  "domain": "sports",
  "family_id": "parallel_unsupervised_supervised_analysis",
  "topology": "parallel",
  "inputs": [
    {
      "id": "input:data.csv",
      "path": "inputs/data.csv",
      "format": "csv",
      "required_columns": [
        "player_id",
        "team",
        "position",
        "games_played",
        "points_per_game",
        "assists_per_game",
        "rebounds_per_game",
        "minutes_per_game",
        "age",
        "experience_years",
        "salary_millions",
        "play_style_score",
        "efficiency_rating",
        "usage_rate",
        "all_star",
        "injury_games_missed",
        "field_goal_pct",
        "three_point_pct",
        "free_throw_pct"
      ]
    }
  ],
  "tasks": [
    {
      "id": "cluster_prepare",
      "name": "Prepare clustering features",
      "operation": "feature_selection",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "clustering_features.csv"
      ],
      "requirements": [
        "Validate players and select the seven ordered clustering features."
      ],
      "parameters": {}
    },
    {
      "id": "cluster_fit",
      "name": "Fit and canonicalize K-means",
      "operation": "kmeans_clustering",
      "required": true,
      "inputs": [
        "clustering_features.csv"
      ],
      "outputs": [
        "player_clusters.csv",
        "cluster_model.pkl"
      ],
      "requirements": [
        "Scale, fit fixed K-means, and canonicalize labels."
      ],
      "parameters": {}
    },
    {
      "id": "cluster_profile",
      "name": "Profile player clusters",
      "operation": "cluster_profiling",
      "required": true,
      "inputs": [
        "player_clusters.csv",
        "cluster_model.pkl",
        "input:data.csv"
      ],
      "outputs": [
        "cluster_profiles.csv",
        "cluster_report.json"
      ],
      "requirements": [
        "Compute declared profiles and silhouette report."
      ],
      "parameters": {}
    },
    {
      "id": "prediction_prepare",
      "name": "Prepare All-Star predictors",
      "operation": "feature_selection",
      "required": true,
      "inputs": [
        "input:data.csv"
      ],
      "outputs": [
        "prediction_features.csv"
      ],
      "requirements": [
        "Validate players/target and select fourteen ordered predictors."
      ],
      "parameters": {}
    },
    {
      "id": "prediction_fit",
      "name": "Fit All-Star classifier",
      "operation": "binary_classification",
      "required": true,
      "inputs": [
        "prediction_features.csv"
      ],
      "outputs": [
        "all_star_model.pkl",
        "all_star_predictions.csv"
      ],
      "requirements": [
        "Use fixed stratified split, train-only scaling, model, and threshold."
      ],
      "parameters": {}
    },
    {
      "id": "prediction_evaluate",
      "name": "Evaluate All-Star predictions",
      "operation": "classification_evaluation",
      "required": true,
      "inputs": [
        "all_star_predictions.csv"
      ],
      "outputs": [
        "all_star_metrics.json"
      ],
      "requirements": [
        "Compute held-out metrics and retain split/feature metadata."
      ],
      "parameters": {}
    }
  ],
  "artifacts": [
    {
      "id": "clustering_features.csv",
      "path": "clustering_features.csv",
      "format": "csv",
      "required_columns": [
        "player_id",
        "team",
        "position",
        "efficiency_rating"
      ]
    },
    {
      "id": "player_clusters.csv",
      "path": "player_clusters.csv",
      "format": "csv",
      "required_columns": [
        "player_id",
        "cluster"
      ]
    },
    {
      "id": "cluster_model.pkl",
      "path": "cluster_model.pkl",
      "format": "pkl",
      "required_columns": []
    },
    {
      "id": "cluster_profiles.csv",
      "path": "cluster_profiles.csv",
      "format": "csv",
      "required_columns": [
        "cluster",
        "player_count",
        "mean_efficiency",
        "mean_usage"
      ]
    },
    {
      "id": "cluster_report.json",
      "path": "cluster_report.json",
      "format": "json",
      "required_columns": []
    },
    {
      "id": "prediction_features.csv",
      "path": "prediction_features.csv",
      "format": "csv",
      "required_columns": [
        "player_id",
        "all_star",
        "games_played"
      ]
    },
    {
      "id": "all_star_model.pkl",
      "path": "all_star_model.pkl",
      "format": "pkl",
      "required_columns": []
    },
    {
      "id": "all_star_predictions.csv",
      "path": "all_star_predictions.csv",
      "format": "csv",
      "required_columns": [
        "player_id",
        "actual_all_star",
        "probability",
        "predicted_all_star"
      ]
    },
    {
      "id": "all_star_metrics.json",
      "path": "all_star_metrics.json",
      "format": "json",
      "required_columns": []
    }
  ],
  "dependencies": [
    {
      "source": "cluster_prepare",
      "target": "cluster_fit",
      "kind": "data",
      "artifacts": [
