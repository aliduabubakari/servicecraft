      "cluster_fit": "sports_parallel",
      "cluster_profile": "sports_parallel",
      "prediction_prepare": "sports_parallel",
      "prediction_fit": "sports_parallel",
      "prediction_evaluate": "sports_parallel"
    }
  },
  "numeric_tolerance": {
