{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "009_healthcare_readmission",
  "benchmark_revision": "batch-03",
  "review_status": "author_review_pending",
  "title": "Patient readmission integration with model and descriptive branches",
  "domain": "healthcare",
  "family_id": "multisource_readmission_analysis",
  "topology": "fan_in_fan_out",
  "inputs": [
    {
      "id": "input:patients.csv",
      "path": "inputs/patients.csv",
      "format": "csv",
      "required_columns": [
        "patient_id",
        "age",
        "gender",
        "race",
        "conditions",
        "has_diabetes",
        "has_heart_condition",
        "bmi",
        "smoker",
        "insurance_type",
        "n_conditions",
        "readmitted_30d"
      ]
    },
    {
      "id": "input:admissions.csv",
      "path": "inputs/admissions.csv",
      "format": "csv",
      "required_columns": [
        "admission_id",
        "patient_id",
        "length_of_stay",
        "icu_stay",
        "n_procedures",
        "er_admission"
      ]
    },
    {
      "id": "input:lab_results.csv",
      "path": "inputs/lab_results.csv",
      "format": "csv",
      "required_columns": [
        "admission_id",
        "patient_id",
        "test_name",
        "test_value",
        "abnormal_flag"
      ]
    },
    {
      "id": "input:medications.csv",
      "path": "inputs/medications.csv",
      "format": "csv",
      "required_columns": [
        "admission_id",
        "patient_id",
        "medication"
      ]
    }
  ],
  "tasks": [
    {
      "id": "prepare_patients",
      "name": "Validate patient records",
      "operation": "source_validation",
      "required": true,
      "inputs": [
        "input:patients.csv"
      ],
      "outputs": [
        "patients_clean.csv"
      ],
      "requirements": [
        "Validate patient keys, numeric measures, and binary target."
      ],
      "parameters": {}
    },
    {
      "id": "aggregate_admissions",
      "name": "Aggregate admissions by patient",
      "operation": "event_aggregation",
      "required": true,
      "inputs": [
        "input:admissions.csv",
        "input:patients.csv"
      ],
      "outputs": [
        "admissions_by_patient.csv"
      ],
      "requirements": [
        "Validate admission/patient keys and compute declared utilization measures."
      ],
      "parameters": {}
    },
    {
      "id": "aggregate_labs",
      "name": "Aggregate laboratory results by patient",
      "operation": "event_aggregation",
      "required": true,
      "inputs": [
        "input:lab_results.csv",
        "input:admissions.csv",
        "input:patients.csv"
      ],
      "outputs": [
        "labs_by_patient.csv"
      ],
      "requirements": [
        "Validate event relationships and compute lab counts/means."
      ],
      "parameters": {}
    },
    {
      "id": "aggregate_medications",
      "name": "Aggregate medications by patient",
      "operation": "event_aggregation",
      "required": true,
      "inputs": [
        "input:medications.csv",
        "input:admissions.csv",
        "input:patients.csv"
      ],
      "outputs": [
        "medications_by_patient.csv"
      ],
      "requirements": [
        "Validate event relationships and compute medication counts."
      ],
      "parameters": {}
    },
    {
      "id": "integrate",
      "name": "Integrate patient feature branches",
      "operation": "multiway_left_join",
      "required": true,
      "inputs": [
        "patients_clean.csv",
        "admissions_by_patient.csv",
        "labs_by_patient.csv",
        "medications_by_patient.csv"
      ],
      "outputs": [
        "patient_features.csv"
      ],
      "requirements": [
        "Left-join all summaries one-to-one and zero-fill absent aggregates."
      ],
      "parameters": {}
    },
    {
      "id": "model",
      "name": "Fit and evaluate readmission classifier",
      "operation": "binary_classification",
      "required": true,
      "inputs": [
        "patient_features.csv"
      ],
      "outputs": [
        "model.pkl",
        "predictions.csv",
        "readmission_metrics.json"
      ],
      "requirements": [
        "Apply the fixed stratified split, train-only scaling, model, threshold, and metrics."
      ],
      "parameters": {}
    },
    {
      "id": "utilization",
      "name": "Compare utilization by readmission status",
      "operation": "grouped_aggregation",
      "required": true,
      "inputs": [
        "patient_features.csv"
      ],
      "outputs": [
        "utilization_by_readmission.csv"
      ],
      "requirements": [
        "Compute the declared utilization measures by target group."
      ],
      "parameters": {}
    },
    {
      "id": "clinical",
      "name": "Summarize clinical burden by insurance",
      "operation": "grouped_aggregation",
      "required": true,
      "inputs": [
        "patient_features.csv"
      ],
      "outputs": [
        "clinical_summary.csv"
      ],
      "requirements": [
        "Compute the declared clinical measures by insurance type."
      ],
      "parameters": {}
    },
    {
      "id": "report",
      "name": "Synthesize readmission analyses",
      "operation": "multi_input_report",
      "required": true,
      "inputs": [
        "readmission_metrics.json",
        "utilization_by_readmission.csv",
        "clinical_summary.csv"
      ],
      "outputs": [
        "readmission_report.json"
      ],
      "requirements": [
        "Consume all three analytical branches and publish source/group/model results."
      ],
      "parameters": {}
    }
  ],
  "artifacts": [
    {
      "id": "patients_clean.csv",
      "path": "patients_clean.csv",
      "format": "csv",
      "required_columns": [
        "patient_id",
        "readmitted_30d"
      ]
    },
    {
      "id": "admissions_by_patient.csv",
      "path": "admissions_by_patient.csv",
      "format": "csv",
      "required_columns": [
        "patient_id",
        "admission_count",
        "total_length_of_stay"
      ]
    },
    {
      "id": "labs_by_patient.csv",
      "path": "labs_by_patient.csv",
      "format": "csv",
      "required_columns": [
        "patient_id",
        "lab_count",
        "abnormal_lab_count"
      ]
    },
    {
      "id": "medications_by_patient.csv",
      "path": "medications_by_patient.csv",
      "format": "csv",
      "required_columns": [
        "patient_id",
        "medication_record_count",
        "unique_medications"
      ]
    },
    {
      "id": "patient_features.csv",
      "path": "patient_features.csv",
      "format": "csv",
      "required_columns": [
        "patient_id",
        "readmitted_30d",
        "admission_count",
        "lab_count",
        "medication_record_count"
      ]
    },
    {
      "id": "model.pkl",
      "path": "model.pkl",
      "format": "pkl",
      "required_columns": []
    },
    {
      "id": "predictions.csv",
      "path": "predictions.csv",
      "format": "csv",
      "required_columns": [
        "patient_id",
        "actual_readmitted",
        "readmission_probability",
        "predicted_readmitted"
      ]
    },
    {
      "id": "readmission_metrics.json",
      "path": "readmission_metrics.json",
      "format": "json",
      "required_columns": []
    },
    {
      "id": "utilization_by_readmission.csv",
      "path": "utilization_by_readmission.csv",
      "format": "csv",
      "required_columns": [
        "readmitted_30d",
        "patient_count",
        "mean_admission_count"
      ]
    },
    {
      "id": "clinical_summary.csv",
      "path": "clinical_summary.csv",
      "format": "csv",
      "required_columns": [
        "insurance_type",
        "patient_count",
        "readmission_rate"
      ]
    },
    {
      "id": "readmission_report.json",
      "path": "readmission_report.json",
      "format": "json",
      "required_columns": []
    }
  ],
  "dependencies": [
    {
      "source": "aggregate_admissions",
      "target": "integrate",
      "kind": "data",
      "artifacts": [
        "admissions_by_patient.csv"
      ]
    },
    {
      "source": "aggregate_labs",
      "target": "integrate",
      "kind": "data",
      "artifacts": [
        "labs_by_patient.csv"
      ]
    },
    {
      "source": "aggregate_medications",
      "target": "integrate",
      "kind": "data",
      "artifacts": [
        "medications_by_patient.csv"
      ]
    },
    {
      "source": "prepare_patients",
      "target": "integrate",
      "kind": "data",
      "artifacts": [
        "patients_clean.csv"
      ]
    },
    {
      "source": "integrate",
      "target": "model",
      "kind": "data",
      "artifacts": [
        "patient_features.csv"
      ]
    },
    {
      "source": "integrate",
      "target": "utilization",
      "kind": "data",
      "artifacts": [
        "patient_features.csv"
      ]
    },
    {
      "source": "integrate",
      "target": "clinical",
      "kind": "data",
      "artifacts": [
        "patient_features.csv"
      ]
    },
    {
      "source": "clinical",
      "target": "report",
      "kind": "data",
      "artifacts": [
        "clinical_summary.csv"
      ]
    },
    {
      "source": "model",
      "target": "report",
      "kind": "data",
      "artifacts": [
        "readmission_metrics.json"
      ]
    },
    {
      "source": "utilization",
      "target": "report",
      "kind": "data",
      "artifacts": [
        "utilization_by_readmission.csv"
      ]
    }
  ],
  "rq1_policy": {
    "task_matching": "reviewed_semantic_mapping",
    "allow_split_or_merge": true,
    "exact_node_count_required": false,
    "data_edges_require_artifact_binding": true,
    "unknown_semantics": "unassessed_not_pass"
  },
  "reference": {
    "entrypoint": "reference.py",
    "task_functions": {
      "prepare_patients": "healthcare",
      "aggregate_admissions": "healthcare",
      "aggregate_labs": "healthcare",
      "aggregate_medications": "healthcare",
      "integrate": "healthcare",
      "model": "healthcare",
      "utilization": "healthcare",
      "clinical": "healthcare",
      "report": "healthcare"
    }
  },
  "numeric_tolerance": {
    "atol": 1e-06,
    "rtol": 1e-06
  }
}