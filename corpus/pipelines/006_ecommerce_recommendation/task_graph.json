{
  "schema_version": "inlumen.benchmark.task-graph@2",
  "pipeline_id": "006_ecommerce_recommendation",
  "benchmark_revision": "batch-02",
  "review_status": "author_review_pending",
  "title": "Deterministic in-stock product recommendation",
  "domain": "retail",
  "family_id": "relational_ranking_recommendation",
  "topology": "linear",
  "inputs": [
    {
      "id": "input:customers.csv",
      "path": "inputs/customers.csv",
      "format": "csv",
      "required_columns": [
        "customer_id"
      ]
    },
    {
      "id": "input:products.csv",
      "path": "inputs/products.csv",
      "format": "csv",
      "required_columns": [
        "product_id",
        "product_name",
        "category",
        "rating",
        "in_stock"
      ]
    },
    {
      "id": "input:orders.csv",
      "path": "inputs/orders.csv",
      "format": "csv",
      "required_columns": [
        "order_id",
        "customer_id",
        "product_id",
        "quantity"
      ]
    }
  ],
  "tasks": [
    {
      "id": "interactions",
      "name": "Validate sources and aggregate purchase interactions",
      "operation": "relational_aggregation",
      "required": true,
      "inputs": [
        "input:customers.csv",
        "input:products.csv",
        "input:orders.csv"
      ],
      "outputs": [
        "interactions.csv"
      ],
      "requirements": [
        "Validate identifiers, foreign keys, quantity, rating, and stock flags.",
        "Aggregate purchased quantity by customer, product, and category."
      ],
      "parameters": {}
    },
    {
      "id": "rank",
      "name": "Score and rank unseen in-stock products",
      "operation": "deterministic_ranking",
      "required": true,
      "inputs": [
        "interactions.csv",
        "input:customers.csv",
        "input:products.csv"
      ],
      "outputs": [
        "recommendations.csv"
      ],
      "requirements": [
        "Compute category affinity, normalized product popularity, and the specified weighted score.",
        "Exclude purchased/out-of-stock products and apply the stated deterministic ties."
      ],
      "parameters": {
        "top_k": 3,
        "weights": {
          "category_affinity": 0.6,
          "popularity": 0.25,
          "rating": 0.15
        }
      }
    },
    {
      "id": "report",
      "name": "Publish recommendation coverage summary",
      "operation": "ranking_report",
      "required": true,
      "inputs": [
        "recommendations.csv",
        "input:customers.csv",
        "input:products.csv"
      ],
      "outputs": [
        "recommendation_report.json"
      ],
      "requirements": [
        "Publish data-derived customer, recommendation, and inventory coverage counts."
      ],
      "parameters": {}
    }
  ],
  "artifacts": [
    {
      "id": "interactions.csv",
      "path": "interactions.csv",
      "format": "csv",
      "required_columns": [
        "customer_id",
        "product_id",
        "category",
        "purchased_quantity"
      ]
    },
    {
      "id": "recommendations.csv",
      "path": "recommendations.csv",
      "format": "csv",
      "required_columns": [
        "customer_id",
        "rank",
        "product_id",
        "product_name",
        "category",
        "score"
      ]
    },
    {
      "id": "recommendation_report.json",
      "path": "recommendation_report.json",
      "format": "json",
      "required_columns": []
    }
  ],
  "dependencies": [
    {
      "source": "interactions",
      "target": "rank",
      "kind": "data",
      "artifacts": [
        "interactions.csv"
      ]
    },
    {
      "source": "rank",
      "target": "report",
      "kind": "data",
      "artifacts": [
        "recommendations.csv"
      ]
    }
  ],
  "rq1_policy": {
    "task_matching": "reviewed_semantic_mapping",
    "allow_split_or_merge": true,
    "exact_node_count_required": false,
    "data_edges_require_artifact_binding": true,
    "unknown_semantics": "unassessed_not_pass"
  },
  "reference": {
    "entrypoint": "reference.py",
    "task_functions": {
      "interactions": "recommend",
      "rank": "recommend",
      "report": "recommend"
    }
  },
  "numeric_tolerance": {
    "atol": 1e-06,
    "rtol": 1e-06
  }
}
